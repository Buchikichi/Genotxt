{
  "name": "Genotxt-repo",
  "description": "Genotxt is a text-to-diagram tool for creating genograms.",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Buchikichi/Genotxt.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Buchikichi/Genotxt/issues"
  },
  "homepage": "https://github.com/Buchikichi/Genotxt#readme",
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "scripts": {
    "dev:@Genotxt/GenotxtJS": "esbuild packages/genotxt/src/index.js --bundle --outfile=packages/genotxt/dist/index.js --format=esm --watch",
    "dev:@Genotxt/web": "vite apps/web",
    "dev": "run-p dev:*"
  }
}